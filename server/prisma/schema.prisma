generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Technician {
  id          Int        @id @default(autoincrement())
  name        String
  zone        String     @default("S")
  fieldWork   Boolean    @default(false)
  status      String     @default("Off Duty")
  workingToday Boolean   @default(false)
  externalId  Int?       @unique
  syncedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  media       Media[]
  timer       Timer?
}

model Media {
  id           Int       @id @default(autoincrement())
  technicianId Int
  type         String
  filePath     String
  fileName     String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
}

model Timer {
  id              Int       @id @default(autoincrement())
  technicianId    Int       @unique
  remainingSeconds Int      @default(0)
  isRunning       Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  technician      Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
